# =============================================================
# NODO Telecom — Variables de entorno (valores de ejemplo, NO sensibles)
# Copiá este archivo a `.env.local` y completá con los datos reales.
# Nunca subas secretos ni credenciales al repositorio.
# =============================================================

# URL pública del sitio (usada para SEO y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp en formato internacional: código de país + número, sin "+", espacios ni guiones.
# Ejemplo para Argentina: 549387XXXXXXX  (REEMPLAZAR por el número real)
NEXT_PUBLIC_WHATSAPP_NUMBER=5493875777543

# Correo de contacto (placeholder, opcional)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Backend futuro (Supabase) — NO requerido en esta versión ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
